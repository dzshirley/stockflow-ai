# Copy to .env for Docker Compose. Development values only; replace every secret in production.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_dev_password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
VITE_DEV_API_TARGET=http://localhost:8080
SESSION_COOKIE_SECURE=false
REGISTRATION_ENABLED=true
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
# Hikari timeout values are milliseconds.
DB_CONNECTION_TIMEOUT=10000
DB_VALIDATION_TIMEOUT=5000
DB_IDLE_TIMEOUT=600000
DB_MAX_LIFETIME=1800000
DB_KEEPALIVE_TIME=120000
DB_SSL_MODE=disable
HTTP_CONNECTION_TIMEOUT=10s
SHUTDOWN_TIMEOUT=30s
MAX_HTTP_REQUEST_HEADER_SIZE=16KB
MAX_HTTP_FORM_POST_SIZE=1MB
MAX_HTTP_SWALLOW_SIZE=1MB
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW=15m
LOGIN_MAX_TRACKED_KEYS=10000

# Frontend build-time public-demo policy. This is not an authorization control;
# the backend REGISTRATION_ENABLED setting is authoritative.
VITE_REGISTRATION_ENABLED=true

# Phase 5 defaults to deterministic mock mode; real provider mode is opt-in.
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override; keep the default for OpenAI.
AI_BASE_URL=https://api.openai.com
AI_TIMEOUT=20s
AI_RETRY_MAX_ATTEMPTS=2
AI_RETRY_INITIAL_BACKOFF=200ms
AI_RETRY_BACKOFF_MULTIPLIER=2
AI_RETRY_MAX_BACKOFF=1s
AI_MAX_TOOL_CALLS=6
AI_MAX_RESPONSE_TOKENS=1200
AI_MAX_QUESTION_LENGTH=1000
AI_MAX_HISTORY_MESSAGES=12
AI_MAX_RESPONSE_CHARACTERS=50000
AI_PRICING_VERSION=2026-10-22
AI_PRICING_MODEL=gpt-4o-mini
AI_INPUT_USD_PER_MILLION=0.15
AI_OUTPUT_USD_PER_MILLION=0.60

# Phase 6 report controls. Retention is a development marker; no deletion job runs.
BUSINESS_ANALYSIS_RETENTION_DAYS=90
BUSINESS_ANALYSIS_MAX_CONTRIBUTION_ROWS=50
BUSINESS_ANALYSIS_PROMPT_VERSION=business-analysis-v1
